{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd frontend && npx vite --port \"${PORT:-5173}\" --strictPort"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "codegen",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": ["app:app", "--app-dir", "backend", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "platform-api",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["backend/api.py"],
      "port": 8400
    }
  ]
}
